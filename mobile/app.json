{
  "expo": {
    "name": "Groww You ERP",
    "slug": "groww-you-erp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "growwyou",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.growwyou.erp",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "This app requires FaceID to secure login credentials."
      },
      "associatedDomains": [
        "applinks:groww-you-erp-billing.onrender.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.growwyou.erp",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "groww-you-erp-billing.onrender.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0F1D",
          "android": {
            "image": "./assets/images/logo-glow.png",
            "imageWidth": 100
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "@sentry/react-native/expo",
        {
          "organization": "groww-you",
          "project": "groww-you-erp-mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b55f82b3-cafb-4165-977d-1e0f9e595b7c"
      }
    }
  }
}
