generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -- MULTI-TENANCY CORE --
model Company {
  id                   Int                    @id @default(autoincrement())
  name                 String
  gstNumber            String?
  address              String?
  mobileNumber         String?
  invoicePrefix        String?
  financialYear        String?
  users                User[]
  customers            Customer[]
  vendors              Vendor[]
  items                Item[]
  invoices             Invoice[]
  stockMovements       StockMovement[]
  financialTransactions FinancialTransaction[]
  returns              Return[]
  vouchers             Voucher[]
  currentFinancialYearStart DateTime?
  financialYearLocked        Boolean                @default(false)
  notifications        Notification[]
  branches             Branch[]
  nicUsername          String?
  nicPassword          String?
  
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

model User {
  id         Int      @id @default(autoincrement())
  companyId  Int
  company    Company  @relation(fields: [companyId], references: [id])
  name       String
  email      String   @unique
  password   String
  role       String   // "SUPER_ADMIN", "COMPANY_ADMIN", "STAFF"
  subRole    String?  // "MANAGER" or "ACCOUNTANT"
  isActive   Boolean  @default(true)
  branchId   Int?
  branch     Branch?  @relation(fields: [branchId], references: [id])
  
  createdAt  DateTime @default(now())
}

// -- MASTER DATA --
model Customer {
  id                 Int                    @id @default(autoincrement())
  companyId          Int
  company            Company                @relation(fields: [companyId], references: [id])
  name               String
  mobile             String
  address            String?
  pincode            String                 @default("000000")
  gstin              String?
  openingBalance     Float                  @default(0.0)
  outstandingBalance Float                  @default(0.0)
  creditLimit        Float                  @default(0.0)
  isActive           Boolean                @default(true)
  invoices           Invoice[]
  returns            Return[]
  financialTransactions FinancialTransaction[]
  vouchers           Voucher[]

  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([companyId, mobile])
  @@index([companyId, createdAt])
}

model Vendor {
  id                 Int                    @id @default(autoincrement())
  companyId          Int
  company            Company                @relation(fields: [companyId], references: [id])
  name               String
  mobile             String
  address            String?
  pincode            String                 @default("000000")
  gstin              String?
  openingBalance     Float                  @default(0.0)
  outstandingBalance Float                  @default(0.0)
  isActive           Boolean                @default(true)
  invoices           Invoice[]
  returns            Return[]
  financialTransactions FinancialTransaction[]
  vouchers           Voucher[]

  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([companyId, createdAt])
}

model Item {
  id               Int             @id @default(autoincrement())
  companyId        Int
  company          Company         @relation(fields: [companyId], references: [id])
  name             String
  sku              String?
  category         String?
  unit             String          // e.g., pcs, box, kg
  purchasePrice    Float
  salePrice        Float
  gstPercentage    Float           @default(0.0)
  openingStock     Int             @default(0)
  minStockAlert    Int             @default(0)
  isActive         Boolean         @default(true)
  hsnCode          String          @default("000000")
  invoiceItems     InvoiceItem[]
  stockMovements   StockMovement[]
  returnItems      ReturnItem[]
  branchStocks     BranchStock[]

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([companyId, sku])
}

// -- TRANSACTION DATA --
model Invoice {
  id             Int           @id @default(autoincrement())
  companyId      Int
  company        Company       @relation(fields: [companyId], references: [id])
  invoiceNo      String
  invoiceType    String        // "SALE" or "PURCHASE"
  invoiceDate    DateTime      @default(now())
  
  customerId     Int?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  vendorId       Int?
  vendor         Vendor?       @relation(fields: [vendorId], references: [id])
  
  items          InvoiceItem[]
  totalItems     Int
  totalQty       Int
  grandTotal     Float
  branchId       Int
  branch         Branch        @relation(fields: [branchId], references: [id])
  pdfUrl         String?
  dispatchPincode  String?
  shippingPincode  String?
  ewayBillNo       String?         @unique
  ewayBillDate     DateTime?
  transporterId    String?
  transporterName  String?
  transportMode    String?
  vehicleNo        String?
  distanceKm       Int?
  gstFilingStatus  String          @default("PENDING")
  gstFilingDate    DateTime?
  
  returns          Return[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([companyId, invoiceNo])
  @@index([companyId, branchId])
  @@index([companyId, invoiceDate])
  @@index([companyId, invoiceType, invoiceDate])
}

model InvoiceItem {
  id             Int      @id @default(autoincrement())
  invoiceId      Int
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId         Int
  item           Item     @relation(fields: [itemId], references: [id])
  qty            Int
  price          Float
  purchasePrice  Float    @default(0.0)
  gstPercentage  Float    @default(0.0)
  gstAmount      Float    @default(0.0)
  total          Float
}

model StockMovement {
  id             Int      @id @default(autoincrement())
  companyId      Int
  company        Company  @relation(fields: [companyId], references: [id])
  itemId         Int
  item           Item     @relation(fields: [itemId], references: [id])
  movementType   String   // "IN" (increase, e.g. Purchase/SalesReturn) or "OUT" (decrease, e.g. Sale/PurchaseReturn)
  qty            Int
  reference      String   // e.g. "Sale Invoice INV-001"
  branchId       Int
  branch         Branch   @relation(fields: [branchId], references: [id])
  createdAt      DateTime @default(now())

  @@index([companyId, itemId])
  @@index([companyId, branchId])
  @@index([companyId, createdAt])
}

// -- MONEY & RETURN LEDGERS (Sprint 3) --
model FinancialTransaction {
  id              Int       @id @default(autoincrement())
  companyId       Int
  company         Company   @relation(fields: [companyId], references: [id])
  customerId      Int?
  customer        Customer? @relation(fields: [customerId], references: [id])
  vendorId        Int?
  vendor          Vendor?   @relation(fields: [vendorId], references: [id])
  transactionType String    // "DEBIT" or "CREDIT"
  amount          Float
  reference       String    // e.g. "Sale Invoice GY-0001"
  voucherId       Int?
  voucher         Voucher?  @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  branchId        Int
  branch          Branch    @relation(fields: [branchId], references: [id])
  createdAt       DateTime  @default(now())

  @@index([companyId, customerId])
  @@index([companyId, vendorId])
  @@index([companyId, branchId])
  @@index([companyId, createdAt])
}

model Voucher {
  id                    Int                    @id @default(autoincrement())
  companyId             Int
  company               Company                @relation(fields: [companyId], references: [id])
  voucherNo             String
  voucherDate           DateTime               @default(now())
  type                  String                 // "PAYMENT", "RECEIPT", "CONTRA", "JOURNAL"
  customerId            Int?
  customer              Customer?              @relation(fields: [customerId], references: [id])
  vendorId              Int?
  vendor                Vendor?                @relation(fields: [vendorId], references: [id])
  debitAccount          String?                // e.g. "Cash", "HDFC Bank", "ICICI Bank"
  creditAccount         String?                // e.g. "Cash", "HDFC Bank", "ICICI Bank"
  amount                Float
  paymentMode           String?                // "Cash", "Bank", "UPI"
  referenceNo           String?
  remarks               String?                // Narration / Remarks
  isCancelled           Boolean                @default(false)
  financialTransactions FinancialTransaction[]
  branchId              Int
  branch                Branch                 @relation(fields: [branchId], references: [id])
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([companyId, type])
  @@index([companyId, branchId])
  @@index([companyId, voucherDate])
}

model Return {
  id             Int          @id @default(autoincrement())
  companyId      Int
  company        Company      @relation(fields: [companyId], references: [id])
  returnNo       String
  returnType     String       // "SALE" or "PURCHASE"
  returnDate     DateTime     @default(now())
  invoiceNo      String?      // Reference to original invoice number
  invoiceId      Int?
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id])
  
  customerId     Int?
  customer       Customer?    @relation(fields: [customerId], references: [id])
  vendorId       Int?
  vendor         Vendor?      @relation(fields: [vendorId], references: [id])
  
  items          ReturnItem[]
  totalItems     Int
  totalQty       Int
  grandTotal     Float
  reason         String?
  branchId       Int
  branch         Branch       @relation(fields: [branchId], references: [id])
  isWrittenOff      Boolean      @default(false)
  legacyInvoiceNo   String?
  legacyInvoiceDate DateTime?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([companyId, returnNo])
  @@index([companyId, branchId])
  @@index([companyId, returnDate])
}

model ReturnItem {
  id             Int      @id @default(autoincrement())
  returnId       Int
  return         Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  itemId         Int
  item           Item     @relation(fields: [itemId], references: [id])
  qty            Int
  price          Float
  gstPercentage  Float    @default(0.0)
  gstAmount      Float    @default(0.0)
  total          Float
}

model Notification {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([companyId])
}

model Branch {
  id                    Int                    @id @default(autoincrement())
  companyId             Int
  company               Company                @relation(fields: [companyId], references: [id])
  name                  String
  address               String?
  mobileNumber          String?
  pincode               String                 @default("000000")
  isActive              Boolean                @default(true)
  
  users                 User[]
  invoices              Invoice[]
  stockMovements        StockMovement[]
  financialTransactions FinancialTransaction[]
  vouchers              Voucher[]
  returns               Return[]
  branchStocks          BranchStock[]
  nicUsername           String?
  nicPassword           String?
  
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model BranchStock {
  id        Int      @id @default(autoincrement())
  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id])
  itemId    Int
  item      Item     @relation(fields: [itemId], references: [id])
  stock     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, itemId])
  @@index([branchId])
  @@index([itemId])
}

